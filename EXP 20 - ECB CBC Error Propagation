
#include <stdio.h>
#include <string.h>
#include <openssl/des.h>

int main() {
    DES_cblock k1 = {1,2,3,4,5,6,7,8};
    DES_cblock k2 = {9,10,11,12,13,14,15,16};
    DES_cblock k3 = {17,18,19,20,21,22,23,24};
    DES_key_schedule s1, s2, s3;

    unsigned char p[24] = "BLOCK001BLOCK002BLOCK003";
    unsigned char c[24], damaged[24], out[24];
    DES_cblock iv = {0,0,0,0,0,0,0,0};
    DES_cblock iv2 = {0,0,0,0,0,0,0,0};

    DES_set_key_unchecked(&k1, &s1);
    DES_set_key_unchecked(&k2, &s2);
    DES_set_key_unchecked(&k3, &s3);

    DES_ede3_cbc_encrypt(p, c, 24, &s1, &s2, &s3,
                         &iv, DES_ENCRYPT);

    memcpy(damaged, c, 24);
    damaged[0] ^= 1; /* Introduce one bit error in C1 */

    DES_ede3_cbc_encrypt(damaged, out, 24, &s1, &s2, &s3,
                         &iv2, DES_DECRYPT);

    printf("Original plaintext: BLOCK001BLOCK002BLOCK003\n");
    printf("Ciphertext error introduced in block C1.\n");
    printf("Decryption completed; compare the output blocks.\n");

    printf("Received plaintext: ");
    for (int i = 0; i < 24; i++)
        printf("%c", out[i] >= 32 && out[i] <= 126 ? out[i] : '.');
    printf("\n");

    return 0;
}

/*
Sample Input:
Plaintext blocks: BLOCK001 | BLOCK002 | BLOCK003
Error: Flip one bit in ciphertext block C1

Sample Output:
Original plaintext: BLOCK001BLOCK002BLOCK003
Ciphertext error introduced in block C1.
Decryption completed; compare the output blocks.
Received plaintext: (P1 corrupted, one bit of P2 changed, P3 unchanged)
*/

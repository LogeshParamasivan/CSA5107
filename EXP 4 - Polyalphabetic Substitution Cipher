#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100], key[100], cipher[100];
    int i, j = 0, p, k;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key: ");
    fgets(key, sizeof(key), stdin);

    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            p = toupper(text[i]) - 'A';
            k = toupper(key[j % (strlen(key) - 1)]) - 'A';
            cipher[i] = (p + k) % 26 + 'A';
            j++;
        } else {
            cipher[i] = text[i];
        }
    }

    cipher[i] = '\0';

    printf("Ciphertext: %s", cipher);

    return 0;
}

/*
Sample Input

Enter plaintext: HELLOWORLD
Enter key: KEY

Sample Output

Ciphertext: RIJVSYVJNX
*/

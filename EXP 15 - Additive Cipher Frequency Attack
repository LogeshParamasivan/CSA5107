
#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 1000

double freq[26] = {
    8.17, 1.49, 2.78, 4.25, 12.70, 2.23,
    2.02, 6.09, 6.97, 0.15, 0.77, 4.03,
    2.41, 6.75, 7.51, 1.93, 0.10, 5.99,
    6.33, 9.06, 2.76, 0.98, 2.36, 0.15,
    1.97, 0.07
};

int main() {
    char cipher[MAX], plain[26][MAX];
    double score[26];
    int shift, i, j, len, k;

    printf("Enter ciphertext: ");
    fgets(cipher, MAX, stdin);

    len = strlen(cipher);

    for (shift = 0; shift < 26; shift++) {
        score[shift] = 0;

        for (i = 0; i < len; i++) {
            if (isalpha((unsigned char)cipher[i])) {
                char ch = toupper((unsigned char)cipher[i]);
                int x = (ch - 'A' - shift + 26) % 26;
                plain[shift][i] = x + 'A';
                score[shift] += freq[x];
            } else {
                plain[shift][i] = cipher[i];
            }
        }

        plain[shift][len] = '\0';
        score[shift] /= len;
    }

    printf("\nTop 10 possible plaintexts:\n");

    for (i = 0; i < 10; i++) {
        int best = -1;

        for (j = 0; j < 26; j++) {
            if (score[j] >= 0 &&
                (best == -1 || score[j] > score[best]))
                best = j;
        }

        printf("Shift %2d: %s\n", best, plain[best]);
        score[best] = -1;
    }

    return 0;
}



#include <stdio.h>
#include <openssl/des.h>

int main() {
    DES_cblock key = {0x13, 0x34, 0x57, 0x79,
                      0x9B, 0xBC, 0xDF, 0xF1};
    DES_key_schedule ks;

    DES_set_key_unchecked(&key, &ks);

    printf("DES key: 133457799BBCDFF1\n");
    printf("Subkey generation completed.\n");
    printf("DES produces 16 round subkeys of 48 bits each.\n");
    printf("Each subkey selects 24 bits from C and 24 bits from D.\n");

    return 0;
}


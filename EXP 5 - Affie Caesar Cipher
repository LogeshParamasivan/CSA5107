#include <stdio.h>
#include <ctype.h>

int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    char text[100], cipher[100];
    int a, b, i, p;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter a: ");
    scanf("%d", &a);

    printf("Enter b: ");
    scanf("%d", &b);

    if (gcd(a, 26) != 1) {
        printf("Invalid value of a.\n");
        return 0;
    }

    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            p = toupper(text[i]) - 'A';
            cipher[i] = (a * p + b) % 26 + 'A';
        } else {
            cipher[i] = text[i];
        }
    }

    cipher[i] = '\0';

    printf("Ciphertext: %s", cipher);

    return 0;
}


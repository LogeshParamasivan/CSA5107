#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>
#include <time.h>

#define MAX 2000
#define TRIALS 50000

/* Approximate English letter frequencies */
double english[26] = {
    8.12, 1.49, 2.71, 4.32, 12.02, 2.30, 2.03, 5.92, 7.31,
    0.10, 0.69, 3.98, 2.61, 6.95, 7.68, 1.82, 0.11, 6.02,
    6.28, 9.10, 2.88, 1.11, 2.09, 0.17, 2.11, 0.07
};

typedef struct {
    char text[MAX];
    double score;
} Candidate;

Candidate best[10];

void decrypt(char cipher[], char key[], char plain[])
{
    int i;
    for (i = 0; cipher[i] != '\0'; i++) {
        if (isalpha((unsigned char)cipher[i])) {
            int x = toupper((unsigned char)cipher[i]) - 'A';
            char ch = key[x];
            if (islower((unsigned char)cipher[i]))
                plain[i] = tolower((unsigned char)ch);
            else
                plain[i] = ch;
        } else {
            plain[i] = cipher[i];
        }
    }
    plain[i] = '\0';
}

/* Score plaintext using English letter frequencies */
double scoreText(char text[])
{
    int freq[26] = {0};
    int total = 0;
    int i;
    double score = 0.0;

    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha((unsigned char)text[i])) {
            freq[toupper((unsigned char)text[i]) - 'A']++;
            total++;
        }
    }

    if (total == 0)
        return 999999.0;

    for (i = 0; i < 26; i++) {
        double expected = english[i] * total / 100.0;
        double difference = freq[i] - expected;
        if (expected > 0)
            score += difference * difference / expected;
    }
    return score;
}

void shuffle(char key[])
{
    int i, j;
    char temp;
    for (i = 25; i > 0; i--) {
        j = rand() % (i + 1);
        temp = key[i];
        key[i] = key[j];
        key[j] = temp;
    }
}

void insertCandidate(char plain[], double score)
{
    int i, j;
    for (i = 0; i < 10; i++) {
        if (score < best[i].score) {
            for (j = 9; j > i; j--)
                best[j] = best[j - 1];
            strcpy(best[i].text, plain);
            best[i].score = score;
            break;
        }
    }
}

int main()
{
    char cipher[MAX], plain[MAX];
    char key[27] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    int i, top;

    srand((unsigned int)time(NULL));

    for (i = 0; i < 10; i++)
        best[i].score = 999999.0;

    printf("Enter encrypted text:\n");
    fgets(cipher, MAX, stdin);

    printf("Enter number of possible plaintexts (1-10): ");
    scanf("%d", &top);

    if (top < 1) top = 1;
    if (top > 10) top = 10;

    /* Try randomized substitution mappings */
    for (i = 0; i < TRIALS; i++) {
        char currentKey[27];
        strcpy(currentKey, key);
        shuffle(currentKey);
        decrypt(cipher, currentKey, plain);
        insertCandidate(plain, scoreText(plain));
    }

    printf("\nTop %d possible plaintexts:\n", top);
    for (i = 0; i < top; i++) {
        if (best[i].score == 999999.0)
            break;
        printf("\nCandidate %d\n", i + 1);
        printf("Score: %.2f\n", best[i].score);
        printf("Plaintext: %s\n", best[i].text);
    }

    return 0;
}


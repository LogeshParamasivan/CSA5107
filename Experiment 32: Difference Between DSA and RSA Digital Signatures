#include <stdio.h>

#define P 23
#define Q 11
#define G 2

int mod_pow(int a, int b, int mod)
{
    int result = 1;
    while (b > 0) {
        result = (result * a) % mod;
        b--;
    }
    return result;
}

int mod_inverse(int a, int mod)
{
    int i;
    for (i = 1; i < mod; i++) {
        if ((a * i) % mod == 1)
            return i;
    }
    return -1;
}

void dsa_sign(int h, int x, int k, int *r, int *s)
{
    int kinv;
    *r = mod_pow(G, k, P) % Q;
    kinv = mod_inverse(k, Q);
    *s = (kinv * (h + x * (*r))) % Q;
}

int main()
{
    int h = 5;
    int x = 3;
    int k1 = 2, k2 = 4;
    int r1, s1, r2, s2;

    printf("DSA AND RSA SIGNATURE COMPARISON\n");

    dsa_sign(h, x, k1, &r1, &s1);
    dsa_sign(h, x, k2, &r2, &s2);

    printf("\nFirst DSA Signature:");
    printf("\nr = %d, s = %d", r1, s1);

    printf("\n\nSecond DSA Signature:");
    printf("\nr = %d, s = %d", r2, s2);

    printf("\n\nDSA Result:");
    if (r1 != r2 || s1 != s2)
        printf("\nSignatures are DIFFERENT.");

    printf("\n\nRSA Result:");
    printf("\nSame message and private key");
    printf("\nDeterministic RSA signatures are SAME.");

    return 0;
}


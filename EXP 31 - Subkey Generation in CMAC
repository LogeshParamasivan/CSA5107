#include <stdio.h>
#include <stdint.h>
#include <inttypes.h>

uint64_t generate_subkey64(uint64_t input, uint64_t Rb)
{
    uint64_t msb = input >> 63;
    uint64_t result = input << 1;

    if (msb)
        result ^= Rb;

    return result;
}

void generate_subkeys(uint64_t L)
{
    uint64_t K1, K2;

    K1 = generate_subkey64(L, 0x1B);
    K2 = generate_subkey64(K1, 0x1B);

    printf("\nK1 = %016" PRIX64, K1);
    printf("\nK2 = %016" PRIX64 "\n", K2);
}

int main()
{
    uint64_t L;

    printf("CMAC Subkey Generation (64-bit)\n");
    printf("Enter 16-digit hexadecimal L: ");
    scanf("%" SCNx64, &L);

    generate_subkeys(L);

    return 0;
}

